<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>netstandard2.0</TargetFrameworks>

		<Authors>Vadim Khalatryan</Authors>
		<Company>World Web Services Inc</Company>
		<Product>EditorConfig</Product>
		<NeutralLanguage>en-US</NeutralLanguage>
		<PackageIcon>icon.png</PackageIcon>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
		<Copyright>Copyright © WWS Inc. $([System.DateTime]::Now.Year)</Copyright>
		<PackageTags>wws-editor-config;editorconfig;analyzers;code-style;sonar</PackageTags>
		<PackageId>Wws.EditorConfig</PackageId>
		<Title>Wws.EditorConfig</Title>
		<Description>Distributes a common .editorconfig file and some common properties.</Description>
		<IsPackable>true</IsPackable>
		<PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
		<NoDefaultExcludes>true</NoDefaultExcludes>

		<!-- Version comes from the git tag (e.g. 1.3.3) via MinVer -->
		<MinVerTagPrefix></MinVerTagPrefix>

		<RepositoryType>git</RepositoryType>
		<PackageProjectUrl>https://github.com/wwsinc/wws-editor-config</PackageProjectUrl>
		<RepositoryUrl>https://github.com/wwsinc/wws-editor-config</RepositoryUrl>
		<!-- Publish the repository URL in the built .nupkg (in the NuSpec <Repository> element) -->
		<PublishRepositoryUrl>true</PublishRepositoryUrl>

		<!-- The package only carries MSBuild props, rule files and the Sonar dependency: no assembly, never flows to consumers' consumers -->
		<IncludeBuildOutput>false</IncludeBuildOutput>
		<DevelopmentDependency>true</DevelopmentDependency>
		<NoWarn>$(NoWarn);NU5128</NoWarn>
		<EnablePackageValidation>true</EnablePackageValidation>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="MinVer" Version="8.0.0" PrivateAssets="All" />
		<!-- Packed as a dependency with all assets, so every consumer restores Sonar and runs its analyzers. The only place its version is set. -->
		<PackageReference Include="SonarAnalyzer.CSharp" Version="[10.35.0.4138]" PrivateAssets="none" />
	</ItemGroup>

	<!-- Flattens the [*.cs] and [*.{cs,vb}] sections of the templates into a global analyzer config (last value wins) -->
	<UsingTask TaskName="WwsCreateGlobalConfig" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
		<ParameterGroup>
			<SourceFiles ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
			<OutputFile ParameterType="System.String" Required="true" />
		</ParameterGroup>
		<Task>
			<Using Namespace="System" />
			<Using Namespace="System.Collections.Generic" />
			<Using Namespace="System.IO" />
			<Using Namespace="System.Linq" />
			<Code Type="Fragment" Language="cs"><![CDATA[
				var globalSections = new HashSet<string>(StringComparer.Ordinal) { "[*.cs]", "[*.{cs,vb}]" };
				var keys = new List<string>();
				var values = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);

				foreach (var source in SourceFiles)
				{
					var inGlobalSection = false;
					foreach (var rawLine in File.ReadAllLines(source.ItemSpec))
					{
						var line = rawLine.Trim();
						if (line.Length == 0 || line[0] == '#' || line[0] == ';')
						{
							continue;
						}
						if (line[0] == '[')
						{
							inGlobalSection = globalSections.Contains(line);
							continue;
						}
						if (!inGlobalSection)
						{
							continue;
						}

						var separator = line.IndexOf('=');
						if (separator <= 0)
						{
							continue;
						}
						var key = line.Substring(0, separator).Trim();
						var value = line.Substring(separator + 1);
						var comment = value.IndexOfAny(new[] { '#', ';' });
						if (comment >= 0)
						{
							value = value.Substring(0, comment);
						}
						value = value.Trim();

						if (!values.ContainsKey(key))
						{
							keys.Add(key);
						}
						values[key] = value;
					}
				}

				var lines = new List<string>
				{
					"# Generated by Wws.EditorConfig from Rules/Templates. Do not edit by hand.",
					"is_global = true",
					"global_level = 100",
					"",
				};
				lines.AddRange(keys.Select(k => k + " = " + values[k]));

				var content = string.Join("\r\n", lines) + "\r\n";
				if (!File.Exists(OutputFile) || File.ReadAllText(OutputFile) != content)
				{
					File.WriteAllText(OutputFile, content);
				}
			]]></Code>
		</Task>
	</UsingTask>

	<!-- Compose the .editorconfig and .globalconfig files from the templates -->
	<Target Name="CreateEditorConfig" BeforeTargets="BeforeBuild">
		<ItemGroup>
			<EditorConfigFilesToJoin Include="Rules\Templates\editorconfig.rules;Rules\Templates\sonar-analyzer.rules" />
		</ItemGroup>
		<ItemGroup>
			<EditorConfigFileContents Include="$([System.IO.File]::ReadAllText(%(EditorConfigFilesToJoin.Identity)))" />
		</ItemGroup>
		<WriteLinesToFile File="Rules\.editorconfig" Lines="@(EditorConfigFileContents)" Overwrite="true" WriteOnlyWhenDifferent="true" />
		<WwsCreateGlobalConfig SourceFiles="@(EditorConfigFilesToJoin)" OutputFile="Rules\.globalconfig" />
	</Target>

	<!-- Select the MSBuild props and composed rule files to pack -->
	<ItemGroup>
		<None Include="../icon.png" Pack="true" Visible="false" PackagePath="/" />
		<None Include="../README.md" Pack="true" Visible="false" PackagePath="/" />
		<None Include="build\Wws.EditorConfig.props" Pack="true" PackagePath="build\" />
		<Content Include="Rules\.editorconfig" Pack="true" PackagePath="content\rules"></Content>
		<Content Include="Rules\.globalconfig" Pack="true" PackagePath="content\rules"></Content>
	</ItemGroup>

	<PropertyGroup Condition="'$(CI_BUILD)' == 'true'">
		<ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
	</PropertyGroup>

</Project>
