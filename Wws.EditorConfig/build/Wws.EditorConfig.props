<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="14.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

	<PropertyGroup>
		<ImplicitUsings>enable</ImplicitUsings>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
		<EnableNETAnalyzers>true</EnableNETAnalyzers>
		<AnalysisMode>All</AnalysisMode>
		<AnalysisLevel>latest</AnalysisLevel>
		<RunAnalyzersDuringBuild>true</RunAnalyzersDuringBuild>
		<RunAnalyzersDuringLiveAnalysis>true</RunAnalyzersDuringLiveAnalysis>
		<TreatWarningsAsErrors>false</TreatWarningsAsErrors>
		<Nullable>enable</Nullable>
		<WarningsAsErrors>nullable</WarningsAsErrors>
		<AccelerateBuildsInVisualStudio>true</AccelerateBuildsInVisualStudio>
	</PropertyGroup>

	<!--
		SonarAnalyzer.CSharp is not added here: NuGet ignores package props during restore, so a PackageReference
		declared in this file is never restored. It ships as a dependency of the package instead (see Wws.EditorConfig.csproj).
	-->

	<!-- Analyzer severities applied by the compiler directly, so they are enforced even where .editorconfig is not copied (CI) -->
	<ItemGroup>
		<GlobalAnalyzerConfigFiles Include="$(MSBuildThisFileDirectory)..\content\rules\.globalconfig" />
	</ItemGroup>

	<ItemGroup>
		<EditorConfigFilesToCopy Include="$(MSBuildThisFileDirectory)..\content\rules\.editorconfig" />
	</ItemGroup>

	<PropertyGroup>
		<_IsCI Condition="'$(TF_BUILD)' == 'true' OR '$(CI_BUILD)' == 'true'">true</_IsCI>
	</PropertyGroup>

	<!-- Walks up from the project directory to the nearest folder holding a .sln/.slnx, stopping at the repository root -->
	<UsingTask TaskName="WwsFindSolutionDirectory" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
		<ParameterGroup>
			<StartDirectory ParameterType="System.String" Required="true" />
			<SolutionDirectory ParameterType="System.String" Output="true" />
		</ParameterGroup>
		<Task>
			<Using Namespace="System" />
			<Using Namespace="System.IO" />
			<Using Namespace="System.Linq" />
			<Code Type="Fragment" Language="cs"><![CDATA[
				var dir = new DirectoryInfo(StartDirectory);
				while (dir != null)
				{
					var hasSolution = dir.EnumerateFiles("*.sln*").Any(f =>
						f.Extension.Equals(".sln", StringComparison.OrdinalIgnoreCase) ||
						f.Extension.Equals(".slnx", StringComparison.OrdinalIgnoreCase));
					if (hasSolution)
					{
						SolutionDirectory = dir.FullName;
						break;
					}
					if (Directory.Exists(Path.Combine(dir.FullName, ".git")) || File.Exists(Path.Combine(dir.FullName, ".git")))
					{
						break;
					}
					dir = dir.Parent;
				}
			]]></Code>
		</Task>
	</UsingTask>

	<!-- Runs before BeforeBuild so the compiler picks up the restored .editorconfig in the same build -->
	<Target Name="CopyEditorConfig" BeforeTargets="BeforeBuild" Condition="'$(_IsCI)' != 'true'">
		<PropertyGroup>
			<_WwsEditorConfigDestinationDir Condition="'$(SolutionDir)' != '' AND '$(SolutionDir)' != '*Undefined*'">$(SolutionDir)</_WwsEditorConfigDestinationDir>
		</PropertyGroup>

		<!-- Building a project directly (no solution): fall back to the nearest solution folder -->
		<WwsFindSolutionDirectory StartDirectory="$(MSBuildProjectDirectory)" Condition="'$(_WwsEditorConfigDestinationDir)' == ''">
			<Output TaskParameter="SolutionDirectory" PropertyName="_WwsEditorConfigDestinationDir" />
		</WwsFindSolutionDirectory>

		<!-- No solution anywhere up to the repository root: keep the rules next to the project -->
		<PropertyGroup>
			<_WwsEditorConfigDestinationDir Condition="'$(_WwsEditorConfigDestinationDir)' == ''">$(MSBuildProjectDirectory)</_WwsEditorConfigDestinationDir>
			<_WwsEditorConfigDestinationDir>$([MSBuild]::EnsureTrailingSlash('$(_WwsEditorConfigDestinationDir)'))</_WwsEditorConfigDestinationDir>
			<_WwsEditorConfigDestinationFile>$(_WwsEditorConfigDestinationDir).editorconfig</_WwsEditorConfigDestinationFile>
		</PropertyGroup>

		<GetFileHash Files="@(EditorConfigFilesToCopy)">
			<Output TaskParameter="Hash" PropertyName="_WwsSourceHash" />
		</GetFileHash>

		<GetFileHash Files="$(_WwsEditorConfigDestinationFile)" Condition="Exists('$(_WwsEditorConfigDestinationFile)')">
			<Output TaskParameter="Hash" PropertyName="_WwsDestinationHash" />
		</GetFileHash>

		<Copy
			SourceFiles="@(EditorConfigFilesToCopy)"
			DestinationFolder="$(_WwsEditorConfigDestinationDir)"
			Condition="'$(_WwsSourceHash)' != '$(_WwsDestinationHash)'"
			UseHardlinksIfPossible="false">
			<Output TaskParameter="CopiedFiles" ItemName="_CopiedEditorConfigFiles" />
		</Copy>

		<Message
			Text="Copied .editorconfig from '@(EditorConfigFilesToCopy)' to '$(_WwsEditorConfigDestinationDir)'"
			Importance="high"
			Condition="'@(_CopiedEditorConfigFiles)' != ''" />
	</Target>

</Project>
